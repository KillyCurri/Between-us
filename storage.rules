rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Files are stored under couples/{coupleId}/...
    match /couples/{coupleId}/{allPaths=**} {
      allow read: if request.auth != null && (
        // allow if user is in couple members list stored in Firestore
        exists(/databases/$(database)/documents/couples/$(coupleId)) &&
        get(/databases/$(database)/documents/couples/$(coupleId)).data.members.hasAny([request.auth.uid])
      );
      allow write: if request.auth != null && (
        request.resource != null &&
        // ensure metadata includes owner and limited size in bytes
        request.resource.size < 5 * 1024 * 1024 &&
        exists(/databases/$(database)/documents/couples/$(coupleId)) &&
        get(/databases/$(database)/documents/couples/$(coupleId)).data.members.hasAny([request.auth.uid])
      );
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
