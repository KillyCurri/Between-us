rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Couples: only members can read/write
    match /couples/{coupleId} {
      allow read, write: if request.auth != null && (
        (resource.data.members is list && request.auth.uid in resource.data.members) ||
        (request.resource.data.members is list && request.auth.uid in request.resource.data.members)
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
